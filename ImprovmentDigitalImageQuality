      "source": [
        "def enhance_dark_image(image_path):\n",
        "    \"\"\"\n",
        "    Mengatasi foto yang terlalu gelap dengan histogram equalization\n",
        "    \"\"\"\n",
        "    # Membaca gambar\n",
        "    image = cv2.imread('/content/gelap.jpeg')\n",
        "\n",
        "    # Konversi ke YUV untuk memisahkan luminance dan chrominance\n",
        "    yuv = cv2.cvtColor(image, cv2.COLOR_BGR2YUV)\n",
        "\n",
        "    # Method 1: Histogram Equalization standar\n",
        "    yuv_eq = yuv.copy()\n",
        "    yuv_eq[:,:,0] = cv2.equalizeHist(yuv[:,:,0])\n",
        "    result_eq = cv2.cvtColor(yuv_eq, cv2.COLOR_YUV2BGR)\n",
        "\n",
        "    # Method 2: CLAHE (Contrast Limited Adaptive Histogram Equalization)\n",
        "    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))\n",
        "    yuv_clahe = yuv.copy()\n",
        "    yuv_clahe[:,:,0] = clahe.apply(yuv[:,:,0])\n",
        "    result_clahe = cv2.cvtColor(yuv_clahe, cv2.COLOR_YUV2BGR)\n",
        "\n",
        "    # Method 3: Gamma correction\n",
        "    gamma = 0.6  # Gamma < 1 untuk mencerahkan\n",
        "    gamma_corrected = np.power(image/255.0, gamma)\n",
        "    gamma_corrected = np.uint8(gamma_corrected * 255)\n",
        "\n",
        "    return image, result_eq, result_clahe, gamma_corrected\n",
        "\n",
        "# Penggunaan\n",
        "original, hist_eq, clahe_result, gamma_result = enhance_dark_image('/content/gelap.jpeg')\n",
        "show_images([original, hist_eq, clahe_result, gamma_result],\n",
        "           ['Original', 'Histogram Eq', 'CLAHE', 'Gamma Correction'])\n"
      ],

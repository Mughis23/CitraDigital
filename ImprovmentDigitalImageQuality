        "def remove_gaussian_noise(image_path):\n",
        "    \"\"\"\n",
        "    Menghilangkan Gaussian noise dari gambar\n",
        "    \"\"\"\n",
        "    # Membaca gambar noisy\n",
        "    noisy_image = cv2.imread('/content/gaussian.jpeg')\n",
        "\n",
        "    # Method 1: Gaussian Blur\n",
        "    gaussian_denoised = cv2.GaussianBlur(noisy_image, (5, 5), 0)\n",
        "\n",
        "    # Method 2: Bilateral Filter (preserve edges)\n",
        "    bilateral_denoised = cv2.bilateralFilter(noisy_image, 9, 75, 75)\n",
        "\n",
        "    # Method 3: Non-Local Means Denoising\n",
        "    nlm_denoised = cv2.fastNlMeansDenoisingColored(\n",
        "        noisy_image, None, 10, 10, 7, 21\n",
        "    )\n",
        "\n",
        "    return noisy_image, gaussian_denoised, bilateral_denoised, nlm_denoised\n",
        "\n",
        "# Penggunaan\n",
        "original, gaussian, bilateral, nlm = remove_gaussian_noise('/content/gaussian.jpeg')\n",
        "show_images([original, gaussian, bilateral, nlm],\n",
        "           ['Noisy Original', 'Gaussian Blur', 'Bilateral Filter', 'NL-Means'])"
      ],

        "def complete_enhancement_pipeline(image_path, save_path=None):\n",
        "    \"\"\"\n",
        "    Pipeline lengkap untuk enhancement gambar dengan berbagai teknik\n",
        "    \"\"\"\n",
        "    # Membaca gambar\n",
        "    original = cv2.imread(image_path)\n",
        "    result = original.copy()\n",
        "\n",
        "    print(\"Memulai enhancement pipeline...\")\n",
        "\n",
        "    # Step 1: Denoising\n",
        "    print(\"Step 1: Menghilangkan noise...\")\n",
        "    result = cv2.fastNlMeansDenoisingColored(result, None, 10, 10, 7, 21)\n",
        "\n",
        "    # Step 2: Brightness dan Contrast adjustment\n",
        "    print(\"Step 2: Menyesuaikan brightness dan contrast...\")\n",
        "    result = cv2.convertScaleAbs(result, alpha=1.2, beta=10)\n",
        "\n",
        "    # Step 3: Histogram equalization pada channel Y\n",
        "    print(\"Step 3: Histogram equalization...\")\n",
        "    yuv = cv2.cvtColor(result, cv2.COLOR_BGR2YUV)\n",
        "    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
        "    yuv[:,:,0] = clahe.apply(yuv[:,:,0])\n",
        "    result = cv2.cvtColor(yuv, cv2.COLOR_YUV2BGR)\n",
        "\n",
        "    # Step 4: Sharpening\n",
        "    print(\"Step 4: Mempertajam gambar...\")\n",
        "    kernel_sharpening = np.array([[-1,-1,-1],\n",
        "                                  [-1, 9,-1],\n",
        "                                  [-1,-1,-1]])\n",
        "    result = cv2.filter2D(result, -1, kernel_sharpening)\n",
        "\n",
        "    # Step 5: Final touch dengan bilateral filter\n",
        "    print(\"Step 5: Final smoothing...\")\n",
        "    result = cv2.bilateralFilter(result, 5, 50, 50)\n",
        "\n",
        "    if save_path:\n",
        "        cv2.imwrite(save_path, result)\n",
        "        print(f\"Hasil disimpan ke: {save_path}\")\n",
        "\n",
        "    return original, result\n",
        "\n",
        "# Penggunaan\n",
        "original, enhanced = complete_enhancement_pipeline('gaussian.jpeg', 'enhanced_output.jpg')\n",
        "show_images([original, enhanced], ['Original', 'Enhanced'])\n"
      ],

        "def sharpen_blurry_image(image_path):\n",
        "    \"\"\"\n",
        "    Mempertajam gambar yang blur menggunakan unsharp masking\n",
        "    \"\"\"\n",
        "    # Membaca gambar blur\n",
        "    blurry_image = cv2.imread('/content/blur.png')\n",
        "\n",
        "    # Method 1: Unsharp Masking\n",
        "    gaussian_blur = cv2.GaussianBlur(blurry_image, (0, 0), 3.0)\n",
        "    unsharp_masked = cv2.addWeighted(blurry_image, 1.5, gaussian_blur, -0.5, 0)\n",
        "\n",
        "    # Method 2: Kernel Sharpening\n",
        "    kernel_sharpening = np.array([[-1,-1,-1],\n",
        "                                  [-1, 9,-1],\n",
        "                                  [-1,-1,-1]])\n",
        "    kernel_sharpened = cv2.filter2D(blurry_image, -1, kernel_sharpening)\n",
        "\n",
        "    # Method 3: Laplacian Sharpening\n",
        "    gray = cv2.cvtColor(blurry_image, cv2.COLOR_BGR2GRAY)\n",
        "    laplacian = cv2.Laplacian(gray, cv2.CV_64F)\n",
        "    laplacian = np.uint8(np.absolute(laplacian))\n",
        "    laplacian_sharpened = cv2.add(gray, laplacian)\n",
        "\n",
        "    return blurry_image, unsharp_masked, kernel_sharpened, laplacian_sharpened\n",
        "\n",
        "# Penggunaan\n",
        "original, unsharp, kernel_sharp, laplacian_sharp = sharpen_blurry_image('/content/blur.png')\n",
        "show_images([original, unsharp, kernel_sharp, laplacian_sharp],\n",
        "           ['Blurry Original', 'Unsharp Mask', 'Kernel Sharpening', 'Laplacian'])\n"
      ],

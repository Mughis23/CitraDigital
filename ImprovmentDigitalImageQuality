        "def remove_salt_pepper_noise(image_path):\n",
        "    \"\"\"\n",
        "    Menghilangkan salt-and-pepper noise menggunakan median filtering\n",
        "    \"\"\"\n",
        "    # Membaca gambar dengan salt-pepper noise\n",
        "    noisy_image = cv2.imread('/content/selt_pepper.png')\n",
        "\n",
        "    # Median filtering dengan berbagai ukuran kernel\n",
        "    median_3 = cv2.medianBlur(noisy_image, 3)\n",
        "    median_5 = cv2.medianBlur(noisy_image, 5)\n",
        "    median_7 = cv2.medianBlur(noisy_image, 7)\n",
        "\n",
        "    return noisy_image, median_3, median_5, median_7\n",
        "\n",
        "# Penggunaan\n",
        "original, med3, med5, med7 = remove_salt_pepper_noise('selt_papper.png')\n",
        "show_images([original, med3, med5, med7],\n",
        "           ['Salt-Pepper Noise', 'Median 3x3', 'Median 5x5', 'Median 7x7'])\n"

        "def adjust_brightness_contrast(image_path, brightness=0, contrast=1.0):\n",
        "    \"\"\"\n",
        "    Menyesuaikan brightness dan contrast gambar\n",
        "    \"\"\"\n",
        "    # Membaca gambar\n",
        "    image = cv2.imread('/content/lowbc.png')\n",
        "\n",
        "    # Method 1: Linear adjustment\n",
        "    linear_adjusted = cv2.convertScaleAbs(image, alpha=contrast, beta=brightness)\n",
        "\n",
        "    # Method 2: Using addWeighted\n",
        "    addweighted_adjusted = cv2.addWeighted(\n",
        "        image, contrast,\n",
        "        np.zeros(image.shape, image.dtype), 0,\n",
        "        brightness\n",
        "    )\n",
        "\n",
        "    # Method 3: Manual pixel manipulation\n",
        "    manual_adjusted = np.clip(contrast * image + brightness, 0, 255).astype(np.uint8)\n",
        "\n",
        "    return image, linear_adjusted, addweighted_adjusted, manual_adjusted\n",
        "\n",
        "# Contoh penggunaan dengan berbagai parameter\n",
        "def demonstrate_brightness_contrast(image_path):\n",
        "    # Brightness variations\n",
        "    _, bright_low, _, _ = adjust_brightness_contrast(image_path, brightness=-50)\n",
        "    _, bright_high, _, _ = adjust_brightness_contrast(image_path, brightness=50)\n",
        "\n",
        "    # Contrast variations\n",
        "    _, _, contrast_low, _ = adjust_brightness_contrast(image_path, contrast=0.5)\n",
        "    _, _, contrast_high, _ = adjust_brightness_contrast(image_path, contrast=2.0)\n",
        "\n",
        "    original = cv2.imread(image_path)\n",
        "\n",
        "    show_images([original, bright_low, bright_high, contrast_low, contrast_high],\n",
        "               ['Original', 'Dark (-50)', 'Bright (+50)', 'Low Contrast', 'High Contrast'])\n",
        "\n",
        "# Penggunaan\n",
        "demonstrate_brightness_contrast('/content/lowbc.png')\n"
      ],
